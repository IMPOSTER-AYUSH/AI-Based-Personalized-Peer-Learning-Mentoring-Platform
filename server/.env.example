# Database & Auth
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/connectskill?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# Multi-instance Socket.IO Coordination & Shared Presence (Recommended on Vercel)
# e.g., Upstash Redis, Redis Cloud, or Aiven
# If omitted, server falls back to single-instance in-memory store
REDIS_URL=rediss://default:xxxx@xxxx.upstash.io:6379

# AI Integration (Groq)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Cloudinary (Media uploads for avatars, chat attachments, audio notes)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Local Server & CORS (Local development only - Vercel dynamically binds these)
PORT=5000
CLIENT_URL=http://localhost:5173

# Optional: Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: SMTP Email Verification
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
