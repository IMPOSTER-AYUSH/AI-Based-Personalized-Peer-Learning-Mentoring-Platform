# Connect Skill — Frontend Environment Variables
# Copy this file to .env for local development

# Local Development Settings:
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000

# Vercel Single-Project Production Settings:
# Since both frontend and backend are deployed under the same Vercel domain,
# you can leave these unset on Vercel (the client defaults to relative /api and same-origin),
# or explicitly set:
# VITE_API_URL=/api
# VITE_SOCKET_URL=
