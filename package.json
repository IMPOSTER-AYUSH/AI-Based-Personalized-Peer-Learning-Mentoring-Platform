{
  "name": "connect-skill",
  "version": "1.0.0",
  "private": true,
  "description": "Connect Skill — AI-Based Peer Learning & Mentoring Platform",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "build": "npm --prefix client run build",
    "install:client": "npm --prefix client install",
    "install:server": "npm --prefix server install",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.64.0",
    "@rollup/rollup-linux-x64-musl": "4.64.0"
  }
}
